<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_cream_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify Donation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/eco_dark_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Scan the donor's QR code, or enter their 6-digit code, to confirm the donation."
            android:textSize="13sp"
            android:textColor="@color/eco_text_gray" />

        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@android:color/transparent"
            android:text="Scan QR Code"
            android:textColor="@color/eco_text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_horizontal"
            android:text="or enter the code manually"
            android:textSize="12sp"
            android:textColor="@color/eco_text_gray" />

        <EditText
            android:id="@+id/etVerificationCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="000000"
            android:inputType="number"
            android:textColor="@color/eco_text_dark"
            android:textColorHint="@color/eco_text_gray"
            android:maxLength="6"
            android:textSize="20sp"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            app:backgroundTint="@android:color/transparent"
            android:text="Verify Donation"
            android:textColor="@color/eco_text_dark"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVerifyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/recentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent verifications"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/eco_text_dark"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/recentDonationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>