<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/eco_cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Donation Basket"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/eco_dark_green"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvDonateSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select the reusable items you're ready to donate."
            android:textSize="13sp"
            android:textColor="@color/eco_text_gray"
            android:layout_marginBottom="16dp" />

        <!-- Shown when there's an active batch awaiting NGO verification -->
        <LinearLayout
            android:id="@+id/activeBatchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_input"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show this code to the NGO staff"
                android:textSize="12sp"
                android:textColor="@color/eco_text_gray" />

            <TextView
                android:id="@+id/tvActiveBatchCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="000000"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/eco_dark_green"
                android:letterSpacing="0.2" />

            <ImageView
                android:id="@+id/ivActiveBatchQr"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:contentDescription="Donation QR code" />

            <TextView
                android:id="@+id/tvActiveBatchInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 items • +0 pts once verified"
                android:textSize="12sp"
                android:textColor="@color/eco_text_gray" />
        </LinearLayout>

        <!-- List of selectable pending items -->
        <LinearLayout
            android:id="@+id/pendingItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvEmptyBasket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No reusable items waiting to be donated. Scan an item first!"
            android:textColor="@color/eco_text_gray"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrepareDonation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@android:color/transparent"
            android:text="Prepare Donation (0 selected)"
            android:textColor="@color/eco_text_dark"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>