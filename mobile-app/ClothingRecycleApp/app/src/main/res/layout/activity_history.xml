<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_cream_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contribution History"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/eco_dark_green"
        android:layout_marginBottom="16dp" />

    <!-- Filter chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_primary"
            android:text="All"
            android:textColor="@color/eco_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipDonated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_card"
            android:text="Donated"
            android:textColor="@color/eco_text_dark"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipRecycled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_card"
            android:text="Recycled"
            android:textColor="@color/eco_text_dark"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipDisposed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:text="Disposed"
            android:textColor="@color/eco_text_dark"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No items in this category yet."
        android:textColor="@color/eco_text_gray"
        android:visibility="gone"
        android:layout_marginTop="24dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>