<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="10dp"
    android:layout_marginBottom="8dp"
    android:elevation="1dp">

    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:background="@color/eco_border_gray"
        android:contentDescription="Item thumbnail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/eco_text_dark" />

        <TextView
            android:id="@+id/tvPointsHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0 pts if confirmed"
            android:textSize="11sp"
            android:textColor="@color/eco_text_gray" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAction"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_button_primary"
        app:backgroundTint="@android:color/transparent"
        android:text="Confirm"
        android:textColor="@color/eco_white"
        android:textSize="12sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

</LinearLayout>