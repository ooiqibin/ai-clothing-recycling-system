<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_cream_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🍃 EcoThread"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/eco_dark_green" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:text="Reset your password"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/eco_dark_green" />

        <TextView
            android:id="@+id/tvForgotIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:text="Enter your email and we will send you a 6-digit code."
            android:textSize="13sp"
            android:textColor="@color/eco_text_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Email Address"
                android:textColor="@color/eco_text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etForgotEmail"
                style="@style/Widget.App.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Your email"
                android:inputType="textEmailAddress" />

            <Button
                android:id="@+id/btnSendCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@android:color/transparent"
                android:text="Send code"
                android:textColor="@color/eco_dark_green"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/stepTwoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"
                    android:text="6-digit code"
                    android:textColor="@color/eco_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etResetCode"
                    style="@style/Widget.App.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:hint="000000"
                    android:inputType="number"
                    android:letterSpacing="0.3"
                    android:maxLength="6"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="New password"
                    android:textColor="@color/eco_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNewPassword"
                    style="@style/Widget.App.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="At least 6 characters"
                    android:inputType="textPassword" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="Confirm new password"
                    android:textColor="@color/eco_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    style="@style/Widget.App.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Type it again"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btnResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    app:backgroundTint="@android:color/transparent"
                    android:text="Change password"
                    android:textColor="@color/eco_dark_green"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvForgotStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResendReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="8dp"
            android:text="Resend code"
            android:textColor="@color/eco_dark_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvBackToLoginFromForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="8dp"
            android:text="Back to login"
            android:textColor="@color/eco_text_dark"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>